{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET: Debug Web API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/src/SeguroBatchEngine.Api/bin/Debug/net10.0/SeguroBatchEngine.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/SeguroBatchEngine.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": ".NET: Debug Worker Service",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-worker",
      "program": "${workspaceFolder}/src/SeguroBatchEngine.Worker/bin/Debug/net10.0/SeguroBatchEngine.Worker.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/SeguroBatchEngine.Worker",
      "stopAtEntry": false
    }
  ]
}